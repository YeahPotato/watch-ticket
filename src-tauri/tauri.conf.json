{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WatchTicket",
  "version": "0.1.3",
  "identifier": "com.watchticket.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Watch Ticket · 行情监听",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/sidecar-x86_64-pc-windows-msvc": "sidecar"
    },
    "windows": {
      "wix": {
        "language": ["zh-CN"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/YeahPotato/watch-ticket/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCNTU0Qjk2NkFEQjE3RDIKUldUU0Y5dHFsa3RWbXdoWU9zbys5SUswUzA4RVRyWXdRcjMyakFOUUpaUFhNdENMYlVxSlMxSHEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
